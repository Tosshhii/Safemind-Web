rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isAdmin() {
      // Admin is the only one who can log into the web app
      return request.auth != null && request.auth.token.email == 'atchazoj6@gmail.com';
    }

    function isOwner(userId) {
      // Checks if a logged-in user is the owner of a document
      return request.auth != null && request.auth.uid == userId;
    }

    // --- Users Collection (Mobile App + Admin) ---
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId);
      
      // progress_history subcollection - admin can read/write
      match /progress_history/{entryId} {
        allow read, write: if isAdmin();
      }
    }

    // --- Patient Subcollections (for Mobile App) ---
    match /users/{userId}/api_predictions/{predictionId} {
      allow read, create: if isOwner(userId);
      // Patients can create/read their *own* predictions
    }
    
    // --- Root /bookedSlots Collection ---
    match /bookedSlots/{docId} {
      // A patient OR an Admin can CREATE a new appointment
      allow create: if (request.auth != null && request.resource.data.userId == request.auth.uid) || isAdmin();
      
      // Any authenticated user can LIST (query) slots for availability
      allow list: if request.auth != null;

      // ONLY the owner or an Admin can GET, UPDATE, or DELETE a specific slot
      allow get, update, delete: if (request.auth != null && resource.data.userId == request.auth.uid) || isAdmin();
    }
    
    // --- consultationRequests Collection ---
    match /consultationRequests/{reqId} {
      // 1. A patient can CREATE a new request for themselves
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      
      // 2. An Admin can UPDATE a request (e.g., to 'approved')
      allow update: if isAdmin();

      // 3. Any logged-in user can LIST slots to check availability
      allow list: if request.auth != null;
      
      // 4. EITHER the Admin OR the patient who owns it can GET the request's details
      allow get: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
    }
    
    
    // --- CollectionGroup Queries (FOR ADMIN DASHBOARD ONLY) ---

    // Allows the admin to query all predictions
   match /{path=**}/api_predictions/{predictionId} {
  allow read: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
}

    // Allows the admin to query all booked slots
    match /{path=**}/bookedSlots/{docId} {
      allow read: if isAdmin();
    }

    // --- Admin-Only Collections ---
    match /followUps/{document} {
      allow read, write: if isAdmin();
    }

    // --- DEFAULT DENY (Must be last) ---
    match /{document=**} {
      allow read, write: if false;
    }
  }
}